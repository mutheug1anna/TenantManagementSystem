<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/viewTenantsTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All Tenants"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/newTenantGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="20dp"
            android:background="#E8EEF7"
            app:layout_constraintTop_toBottomOf="@id/viewTenantsTitleTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Just Added"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/newTenantTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:paddingTop="8dp" />

            <Button
                android:id="@+id/callButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Call Tenant"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/allTenantsHeadingTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tenant List"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/newTenantGroup"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tenantsListTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="No tenants added yet."
            android:textSize="16sp"
            android:paddingTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/allTenantsHeadingTextView"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
